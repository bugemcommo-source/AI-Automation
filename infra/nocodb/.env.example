# =============================================================================
# Copy to .env and fill in. NEVER commit the filled-in .env.
#
#   cp .env.example .env
#
# Generate each secret with:  openssl rand -base64 32
# =============================================================================

# --- NocoDB's own metadata database (internal to compose, not your data) -----
NOCO_META_USER=nocodb
NOCO_META_PASSWORD=change-me-metadata-password

# --- NocoDB session signing --------------------------------------------------
NC_AUTH_JWT_SECRET=change-me-long-random-string

# --- The first login ---------------------------------------------------------
# Change the password from inside NocoDB immediately after first sign-in.
NC_ADMIN_EMAIL=owner@example.com
NC_ADMIN_PASSWORD=change-me-first-login-password


# =============================================================================
# The Supabase connection is NOT set here.
#
# You add it inside NocoDB, after signing in, via "Connect external data
# source". That is deliberate: NocoDB stores it encrypted in its own metadata
# rather than leaving a production database password sitting in a file on
# disk next to a compose config.
#
# Use these values when it asks:
#
#   Host       <project>.supabase.co        (Supabase → Settings → Database)
#   Port       5432
#   Database   postgres
#   Username   editor_role                  <- NOT postgres, NOT service_role
#   Password   the editor_role password you set in db/001, Section 8
#   SSL        Enabled / require
#
# Then, when NocoDB asks which tables to import, select ONLY:
#
#   kb_editor      the knowledge base
#   rules_editor   the escalation rules
#   queue_editor   questions waiting for a human  (read-only)
#
# editor_role cannot reach messages, conversations or kb_audit at all, so
# customer conversation history is not exposed to the editor even by accident.
# =============================================================================
